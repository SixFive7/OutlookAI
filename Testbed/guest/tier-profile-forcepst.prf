;=============================================================================================
; THE TIER PROFILE'S TEMPLATE - THE ONE THAT WORKS, AND New-TierProfile.ps1's DEFAULT.
;=============================================================================================
;
; IMPORTED ON BOTH GUESTS (OutlookAI-Indexed and OutlookAI-Unindexed, 2026-09-15/16), and it
; produces what the live tier needs: one POP3 account pointed at a loopback mail sink, with its
; DeliveryStore BOUND and that store's Drafts folder resolving over COM. Until 2026-09-24 this
; banner still said "never imported" and New-TierProfile.ps1 still defaulted to tier-profile.prf,
; so the working build could only be reproduced by knowing to pass -TemplatePath.
;
; WHAT MAKES IT WORK is what it LEAVES OUT: there is NO PST service and NO [General] DefaultStore.
; Outlook therefore mints the account's own delivery store - and a store Outlook mints is a store
; Outlook binds, which is the one step a text file cannot perform (PROP_ACCT_DELIVERY_STORE is a
; binary EntryID). WHERE it mints is ForcePSTPath, a REG_EXPAND_SZ under
; HKCU\Software\Microsoft\Office\16.0\Outlook that New-TierProfile.ps1 -Execute now writes
; (-WorkDir, C:\OutlookAI-Tier by default); Outlook names the minted store 'Outlook Data File',
; and Rename-OutlookStore.ps1 then names it as the account's address. Do NOT add a PST service or
; DefaultStore back: that is tier-profile.prf, it left DeliveryStore NULL when it was measured,
; and New-TierProfile.ps1 refuses a template of that shape.
;
; Testbed/guest/New-TierProfile.ps1 renders this file - it substitutes the {{...}} tokens and
; rewrites the result as ASCII with CRLF line endings, so whatever this file's line endings are
; in git does not matter.
;
; DO NOT IMPORT THIS FILE DIRECTLY. The tokens below are not valid PRF values.
;
; WHY EVERY LINE IS HERE is recorded in Docs/research/pop3-account-routes.md section A.2, with a
; source for each key. The short version:
;   - Sections 1-5 are the customisation. Section 5's key spellings are Microsoft's own literal
;     POP3 block from the Office 2007 Resource Kit; do not "tidy" them.
;   - Sections 6 and 7 are the property mappings and are shipped VERBATIM from OCT-generated
;     output. Microsoft: "You typically do not modify existing entries in Sections 6 and 7."
;     A property with no mapping in section 7 is written NOWHERE, silently.
;   - There is deliberately NO password key. No published POP3 [AccountN] block has one, which
;     is exactly what this profile wants - and why every start of the profile raises the POP3
;     password dialog on the guests (it does not block COM).
;   - BackupProfile=No is what stops a repeat import creating a "Backup Of <name>" profile.
;     Microsoft spells it False once, in passing; the community spells it No. Which one 16.x
;     honours is UNTESTED - if a run leaves a backup profile, try the other spelling.

; **************************************************************
; Section 1 - Profile Defaults
; **************************************************************

[General]
Custom=1
ProfileName={{PROFILE_NAME}}
DefaultProfile=Yes
OverwriteProfile=Yes
BackupProfile=No
ModifyDefaultProfileIfPresent=FALSE

; **************************************************************
; Section 2 - Services in Profile
; **************************************************************

[Service List]
;ServiceX=Microsoft Outlook Client
Service1=Outlook Address Book

;***************************************************************
; Section 3 - List of internet accounts
;***************************************************************

[Internet Account List]
Account1=I_Mail

;***************************************************************
; Section 4 - Default values for each service.
;***************************************************************

[Service1]

;***************************************************************
; Section 5 - Values for each internet account.
;***************************************************************

[Account1]
UniqueService=No
AccountName={{ACCOUNT_NAME}}
POP3Server={{POP3_HOST}}
SMTPServer={{SMTP_HOST}}
POP3UserName={{POP3_USER}}
EmailAddress={{EMAIL_ADDRESS}}
POP3UseSPA=0
DisplayName={{DISPLAY_NAME}}
ReplyEMailAddress=
SMTPUseAuth=0
SMTPAuthMethod=0
SMTPUserName=
ConnectionType=0
LeaveOnServer=0x0
ConnectionOID=
POP3Port={{POP3_PORT}}
POP3UseSSL=0
ServerTimeOut=60
SMTPPort={{SMTP_PORT}}
SMTPUseSSL=0
DefaultAccount=TRUE

;***************************************************************
; Section 6 - Mapping for profile properties.  DO NOT MODIFY.
;***************************************************************

[Microsoft Exchange Server]
ServiceName=MSEMS
MDBGUID=5494A1C0297F101BA58708002B2A2517
MailboxName=PT_STRING8,0x6607
HomeServer=PT_STRING8,0x6608
OfflineAddressBookPath=PT_STRING8,0x660E
OfflineFolderPath=PT_STRING8,0x6610

[Exchange Global Section]
SectionGUID=13dbb0c8aa05101a9bb000aa002fc45a
MailboxName=PT_STRING8,0x6607
HomeServer=PT_STRING8,0x6608
RPCoverHTTPflags=PT_LONG,0x6623
RPCProxyServer=PT_UNICODE,0x6622
RPCProxyPrincipalName=PT_UNICODE,0x6625
RPCProxyAuthScheme=PT_LONG,0x6627
CachedExchangeConfigFlags=PT_LONG,0x6629

[Personal Folders]
ServiceName=MSPST MS
Name=PT_STRING8,0x3001
PathToPersonalFolders=PT_STRING8,0x6700
RememberPassword=PT_BOOLEAN,0x6701
EncryptionType=PT_LONG,0x6702
Password=PT_STRING8,0x6703

[Unicode Personal Folders]
ServiceName=MSUPST MS
Name=PT_UNICODE,0x3001
PathToPersonalFolders=PT_STRING8,0x6700
RememberPassword=PT_BOOLEAN,0x6701
EncryptionType=PT_LONG,0x6702
Password=PT_STRING8,0x6703

[Outlook Address Book]
ServiceName=CONTAB

[LDAP Directory]
ServiceName=EMABLT
ServerName=PT_STRING8,0x6600
UserName=PT_STRING8,0x6602
UseSSL=PT_BOOLEAN,0x6613
UseSPA=PT_BOOLEAN,0x6615
DisableVLV=PT_LONG,0x6616
DisplayName=PT_STRING8,0x3001
ConnectionPort=PT_STRING8,0x6601
SearchTimeout=PT_STRING8,0x6607
MaxEntriesReturned=PT_STRING8,0x6608
SearchBase=PT_STRING8,0x6603

[Microsoft Outlook Client]
SectionGUID=0a0d020000000000c000000000000046
FormDirectoryPage=PT_STRING8,0x0270
WebServicesLocation=PT_STRING8,0x0271
ComposeWithWebServices=PT_BOOLEAN,0x0272
PromptWhenUsingWebServices=PT_BOOLEAN,0x0273
OpenWithWebServices=PT_BOOLEAN,0x0274
CachedExchangeMode=PT_LONG,0x041f
CachedExchangeSlowDetect=PT_BOOLEAN,0x0420

[Personal Address Book]
ServiceName=MSPST AB
NameOfPAB=PT_STRING8,0x001e3001
Path=PT_STRING8,0x001e6600
ShowNamesBy=PT_LONG,0x00036601

; ************************************************************************
; Section 7 - Mapping for internet account properties.  DO NOT MODIFY.
; ************************************************************************

[I_Mail]
AccountType=POP3
;--- POP3 Account Settings ---
AccountName=PT_UNICODE,0x0002
DisplayName=PT_UNICODE,0x000B
EmailAddress=PT_UNICODE,0x000C
;--- POP3 Account Settings ---
POP3Server=PT_UNICODE,0x0100
POP3UserName=PT_UNICODE,0x0101
POP3UseSPA=PT_LONG,0x0108
Organization=PT_UNICODE,0x0107
ReplyEmailAddress=PT_UNICODE,0x0103
POP3Port=PT_LONG,0x0104
POP3UseSSL=PT_LONG,0x0105
; --- SMTP Account Settings ---
SMTPServer=PT_UNICODE,0x0200
SMTPUseAuth=PT_LONG,0x0203
SMTPAuthMethod=PT_LONG,0x0208
SMTPUserName=PT_UNICODE,0x0204
SMTPUseSPA=PT_LONG,0x0207
ConnectionType=PT_LONG,0x000F
ConnectionOID=PT_UNICODE,0x0010
SMTPPort=PT_LONG,0x0201
SMTPUseSSL=PT_LONG,0x0202
ServerTimeOut=PT_LONG,0x0209
LeaveOnServer=PT_LONG,0x1000

[IMAP_I_Mail]
AccountType=IMAP
;--- IMAP Account Settings ---
AccountName=PT_UNICODE,0x0002
DisplayName=PT_UNICODE,0x000B
EmailAddress=PT_UNICODE,0x000C
;--- IMAP Account Settings ---
IMAPServer=PT_UNICODE,0x0100
IMAPUserName=PT_UNICODE,0x0101
IMAPUseSPA=PT_LONG,0x0108
Organization=PT_UNICODE,0x0107
ReplyEmailAddress=PT_UNICODE,0x0103
IMAPPort=PT_LONG,0x0104
IMAPUseSSL=PT_LONG,0x0105
; --- SMTP Account Settings ---
SMTPServer=PT_UNICODE,0x0200
SMTPUseAuth=PT_LONG,0x0203
SMTPAuthMethod=PT_LONG,0x0208
SMTPUserName=PT_UNICODE,0x0204
SMTPUseSPA=PT_LONG,0x0207
ConnectionType=PT_LONG,0x000F
ConnectionOID=PT_UNICODE,0x0010
SMTPPort=PT_LONG,0x0201
SMTPUseSSL=PT_LONG,0x0202
ServerTimeOut=PT_LONG,0x0209
CheckNewImap=PT_LONG,0x1100
RootFolder=PT_UNICODE,0x1101

