<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows x64 console host (v3.MD section 0.4, Option A). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.McpServer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Official MCP C# SDK. 2.2.0 = latest stable on nuget.org as of 2026-08-16.
      Not held back: track latest. Fallback if the SDK ever becomes unusable:
      hand-rolled stdio JSON-RPC (~200 LOC, spec stable) - the T3 conformance test
      already speaks raw JSON-RPC and would carry over as-is.
    -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
    <!--
      The killable COM child (see "Why two processes" in McpServer/README.md). Referencing the Exe project does two
      jobs at once: it shares the pipe contract types, and it makes the SDK copy
      OutlookAI.ComHost.exe into this project's output - which is how the parent finds
      the child via AppContext.BaseDirectory in dev builds as well as installed ones.
      Same pattern as OutlookAI.RemediationTools.
    -->
    <ProjectReference Include="..\OutlookAI.ComHost\OutlookAI.ComHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The add-in's user-editable prompt store and the shipped prompt text, compiled straight
      into this server - the same source files the add-in and the T1 suite use, never a copy.
      WritingRulesGate delivers the user's "Always sent" writing rules to agents, and those
      rules have to be the SAME text the sidebar shows: a second copy of the defaults or of
      the registry key path would drift the moment either side is edited, and the drift would
      be invisible (both halves keep working, they just stop agreeing). Framework-neutral by
      design, which is why the file can serve a net48 VSTO add-in and a net10 console host at
      once.
    -->
    <Compile Include="..\..\Services\PromptDefaults.cs" Link="Linked\PromptDefaults.cs" />
    <Compile Include="..\..\Services\PromptStore.cs" Link="Linked\PromptStore.cs" />

    <!--
      Those two files are internal apart from PromptSection, and the T1 suite pins their rules
      directly (PromptStoreTests drives PromptStoreCore against a fabricated IPromptRegistry;
      the gate tests drive WritingRulesGate against an injected rules source). Same reason the
      COM host opens its internals to this test assembly. Note it also has to be here rather
      than in the test project: the tests used to link these same two files, which compiled a
      second copy of PromptSection into the test assembly and broke the build with CS0436.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OutlookAI.McpServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
