<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows x64 console host (v3.MD section 0.4, Option A). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.McpServer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Official MCP C# SDK, pinned (v3.MD Phase 0 / risk register). 1.4.1 = latest
      stable on nuget.org as of 2026-07-23 (2.0.0 is still preview). Fallback if the
      SDK ever becomes unusable: hand-rolled stdio JSON-RPC (~200 LOC, spec stable) -
      the T3 conformance test already speaks raw JSON-RPC and would carry over as-is.
    -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
  </ItemGroup>

</Project>
