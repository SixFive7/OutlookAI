<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-target (v3.MD D18 v2 / R10): net10.0-windows is consumed by the MCP server
      host today; net48 is CI-gated from day one so the v3.1 event host (most likely
      the existing VSTO add-in, .NET Framework 4.8) can reference Core without rewrite.
    -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <RootNamespace>OutlookAI.Core</RootNamespace>
    <!--
      Implicit usings are disabled: the default set includes System.Net.Http, which is
      not referenced by default on net48 and would break that target.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Description>Host-neutral domain logic for OutlookAI v3 (index search, EntryID codec, COM gateway, models, audit). No MCP types, no console assumptions, no per-session state (v3.MD section 0.5.2).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets `dotnet build` compile the net48 target without a Visual Studio install (CI + local). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!--
      SystemIndex access: OLE DB over Search.CollatorDSO (v3.MD section 4). Windows-only
      at runtime; the package carries a net462 asset for the net48 target. Pinned in the
      10.0.x family alongside Microsoft.Extensions.Hosting (v3.MD D31 companion pins).
    -->
    <PackageReference Include="System.Data.OleDb" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The values the add-in and this server have to agree about: the two HKCU keys the add-in
      writes and HealthReporting reads, and the Claude Code configuration file one repairs and the
      other reports on. The add-in is net48/VSTO and cannot be referenced from here, so the FILE
      is shared instead - the same trick PromptDefaults/PromptStore use for OutlookAI.McpServer
      and McpConfigEditor uses for the test project. Constants only, and internal on purpose: a
      public type in a file linked into two assemblies that see each other is CS0436, an error
      under TreatWarningsAsErrors. Anything the server must expose is re-exported by
      HealthReporting's own public constants.
    -->
    <Compile Include="..\..\Services\AddInServerContract.cs" Link="Linked\AddInServerContract.cs" />
    <!--
      And the Office major versions the product supports, plus the probe that finds which one is
      actually installed. Linked for the same reason and under the same rules (internal, C# 7.3,
      no nullable annotations): the server used to hardcode 16.0 in the Outlook Search key, that
      key's Policies mirror and the whole profile registry, so on Outlook 2013 or a future 17.0 it
      read hives Outlook never writes and reported empty signatures, empty accounts and no search
      settings - indistinguishable from a broken install. Sharing the FILE rather than
      reimplementing the list is what makes both halves probe the same versions in the same order.
      OutlookProfileRegistry re-exports what callers outside Core need.
    -->
    <Compile Include="..\..\Services\OfficeVersions.cs" Link="Linked\OfficeVersions.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- dynamic (late-bound Outlook/ADODB COM) needs the C# runtime binder on .NET Framework. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
