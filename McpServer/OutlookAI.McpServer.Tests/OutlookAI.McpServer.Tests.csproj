<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <!-- x64 to match the server host; T2 live tests (Phase 1+) will also need an x64
         test host for the Search.CollatorDSO OLE DB provider. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.McpServer.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- PNG encoding for the S5 screenshot evidence (T2 live tier only; Windows-only
         like the rest of the test host). Pinned in the 11.0.x family (v3.MD D31; 10.0.x until
         the move to .NET 11, Q172). -->
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
    <ProjectReference Include="..\OutlookAI.McpServer\OutlookAI.McpServer.csproj" />
    <!-- The corpus console (OutlookAI.RemediationTools): referenced so the T1 and T2 tiers pin
         its plans, safety rules and manifests without Outlook, and the project keeps compiling.
         Its incident commands went on 2026-11-18 (Q170 (a)). -->
    <ProjectReference Include="..\OutlookAI.RemediationTools\OutlookAI.RemediationTools.csproj" />
    <!-- The helper setup runs to put the mail server's private .NET runtime in place (Q172):
         referenced so T1 PrivateRuntimeTests can run its one class against packages built by the
         test. Its net11.0-windows build; the net48 one is what ships. -->
    <ProjectReference Include="..\OutlookAI.RuntimeSetup\OutlookAI.RuntimeSetup.csproj" />
    <!-- The audit log's multi-process stress writer (Q117). Referenced for build ORDER only - the
         stress tests start its two executables, they do not load its assembly - and as an outer
         build (SkipGetTargetFrameworkProperties), which is what builds its net48 target as well as
         its net11.0-windows one. -->
    <ProjectReference Include="..\OutlookAI.AuditLogStress\OutlookAI.AuditLogStress.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sequential collections: live tests share one Outlook and time COM operations;
         parallel collections would also let the fresh-mode send race the oracle walk.
         diagnosticMessages is ON because the diagnostic channel is the ONLY one xunit
         reports longRunningTestSeconds through: with it off, that setting was inert, and a
         wedged test stayed indistinguishable from a slow one until the job timeout killed
         the run without naming which test hung. Measured before switching it on: zero extra
         output lines across the whole Category!=Live run (1284 tests), because no test in
         that tier reaches the 120 s threshold and the long-running reports are the only
         diagnostics this configuration emits - one line per hung test per 120 s elapsed.
         The rationale lives here because xunit parses xunit.runner.json as strict JSON,
         which cannot carry a comment. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- No file of the add-in is compiled here any more. The logic the T1 suite pins that the add-in
         shares or runs alone - the MCP configuration surgery and the decision when it may act, the
         prompt store and its checks, the update schedule, the tuning reconcile and the Cached Mode
         settings - lives in OutlookAI.Core's namespace OutlookAI.Core.AddIn since the code-sharing
         refactor's stage S3 (Q163 (a)), and this project references Core: the tests exercise the
         one compiled copy the add-in loads. Two files are still linked, and neither is the add-in's. -->
    <!-- The stress writer's payload rule (Q117), so the stress tests recompute every line they
         expect from the same code that wrote it. Its assembly is not referenced, so no type is
         compiled twice in front of one compilation. -->
    <Compile Include="..\OutlookAI.AuditLogStress\StressLines.cs" Link="Linked\StressLines.cs" />
    <!-- The testbed's hand-declared Windows Search Crawl Scope Manager interop. It ships as
         SOURCE to the guests, where Windows PowerShell 5.1's Add-Type compiles it, so there is
         no assembly to reference; linking the file is the only way to pin the exact code the
         guest compiles. T1/SearchCrawlScopeInteropTests checks every IID and every vtable slot
         by reflection against SearchAPI.h. Public types in their own namespace, compiled nowhere
         else in this solution, so nothing can collide as CS0436. -->
    <Compile Include="..\..\Testbed\guest\SearchCrawlScope.cs" Link="Linked\SearchCrawlScope.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Absolute path to the built server exe, baked in at build time so the T3
         conformance test can spawn it regardless of the test host's working directory.
         The ProjectReference above guarantees the exe is built first. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>McpServerExePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\OutlookAI.McpServer\bin\$(Configuration)\net11.0-windows\OutlookAI.McpServer.exe'))</_Parameter2>
    </AssemblyAttribute>
    <!-- Test project directory, so T2 live tests can locate the gitignored
         live-fixtures/ folder (machine-local settings; never committed - v3.MD S6). -->
    <!-- Where the stress writer's builds land: <this>\net11.0-windows and <this>\net48 (Q117). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AuditLogStressBinDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\OutlookAI.AuditLogStress\bin\$(Configuration)'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestProjectDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
