<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- x64 to match the server host; T2 live tests (Phase 1+) will also need an x64
         test host for the Search.CollatorDSO OLE DB provider. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.McpServer.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- PNG encoding for the S5 screenshot evidence (T2 live tier only; Windows-only
         like the rest of the test host). Pinned in the 10.0.x family (v3.MD D31). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
    <ProjectReference Include="..\OutlookAI.McpServer\OutlookAI.McpServer.csproj" />
    <!-- Incident-7 remediation console (one-shot operator tool): referenced so its
         decision rules stay pinned by T1 RemediationRulesTests and the project keeps
         compiling in CI. -->
    <ProjectReference Include="..\OutlookAI.RemediationTools\OutlookAI.RemediationTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sequential collections: live tests share one Outlook and time COM operations;
         parallel collections would also let the fresh-mode send race the oracle walk.
         diagnosticMessages is ON because the diagnostic channel is the ONLY one xunit
         reports longRunningTestSeconds through: with it off, that setting was inert, and a
         wedged test stayed indistinguishable from a slow one until the job timeout killed
         the run without naming which test hung. Measured before switching it on: zero extra
         output lines across the whole Category!=Live run (1284 tests), because no test in
         that tier reaches the 120 s threshold and the long-running reports are the only
         diagnostics this configuration emits - one line per hung test per 120 s elapsed.
         The rationale lives here because xunit parses xunit.runner.json as strict JSON,
         which cannot carry a comment. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The add-in's MCP configuration surgery, compiled straight into this test assembly.
         It edits files the add-in does not own (~/.claude.json and a project's .mcp.json),
         where a bad splice silently destroys the user's configuration, so it is written
         framework-neutral (no JavaScriptSerializer, no System.Text.Json) precisely so the
         T1 suite can pin the code that actually ships rather than a re-implementation.
         The add-in itself is net48/VSTO and cannot be referenced from here. -->
    <Compile Include="..\..\Services\McpConfigEditor.cs" Link="Linked\McpConfigEditor.cs" />
    <!-- McpConfigEditor takes its `mcpServers` / `outlookai` / `command` names from the shared
         add-in-to-server contract, so that file has to be linked here too. It is safe to link
         (unlike PromptStore below) precisely because it is INTERNAL: OutlookAI.Core compiles the
         same file, and Core grants this assembly no InternalsVisibleTo, so Core's copy is
         invisible here and the two cannot collide as CS0436. Making that type public - or linking
         it into OutlookAI.McpServer, which DOES open its internals to this assembly - would break
         the build immediately. -->
    <Compile Include="..\..\Services\AddInServerContract.cs" Link="Linked\AddInServerContract.cs" />
    <!-- And the rules deciding WHEN the add-in may change that configuration by itself and
         when it must stop and ask the user instead. Linked for the same reason: acting on
         guessed intent is what destroys a registration someone set up on purpose, so the
         decision matrix is pinned as the shipped code rather than as a copy of it. -->
    <Compile Include="..\..\Services\McpRegistrationDecision.cs" Link="Linked\McpRegistrationDecision.cs" />
    <!-- The user-editable prompt store and the built-in prompt text are NOT linked here any
         more: OutlookAI.McpServer now compiles those two files itself (its WritingRulesGate
         hands the user's writing rules to agents), and this project references it, so the T1
         suite reaches exactly the same source through InternalsVisibleTo. Linking them here as
         well would compile a SECOND copy of every type into this assembly - the public
         PromptSection then exists twice in one compilation, which is CS0436, an error under
         TreatWarningsAsErrors. One compiled copy per type, and it is still the shipped file:
         the store's override-only rule (an absent value means "use the code default", so
         nothing shipped is ever copied to disk and frozen there) is invisible until it breaks,
         and the registry sits behind IPromptRegistry so the T1 suite exercises the rules
         against a fabricated store instead of the developer's own HKCU. -->
    <Compile Include="..\..\Services\PromptLint.cs" Link="Linked\PromptLint.cs" />
    <!-- The add-in updater's poll schedule: the first-check delay and the failure backoff, as
         pure arithmetic. UpdateService itself cannot be linked (HttpClient, a Timer, Outlook's
         process lifetime, JavaScriptSerializer), which is precisely why the schedule was split
         out of it - the curve that decides how hard an offline machine hammers GitHub is worth
         pinning, and this is the only compilation that can pin it. Internal, so Core's and this
         assembly's copies of the other linked files cannot collide as CS0436. -->
    <Compile Include="..\..\Services\UpdatePollSchedule.cs" Link="Linked\UpdatePollSchedule.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Absolute path to the built server exe, baked in at build time so the T3
         conformance test can spawn it regardless of the test host's working directory.
         The ProjectReference above guarantees the exe is built first. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>McpServerExePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\OutlookAI.McpServer\bin\$(Configuration)\net10.0-windows\OutlookAI.McpServer.exe'))</_Parameter2>
    </AssemblyAttribute>
    <!-- Test project directory, so T2 live tests can locate the gitignored
         live-fixtures/ folder (machine-local settings; never committed - v3.MD S6). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestProjectDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
