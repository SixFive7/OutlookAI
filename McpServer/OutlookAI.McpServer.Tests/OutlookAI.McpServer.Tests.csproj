<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- x64 to match the server host; T2 live tests (Phase 1+) will also need an x64
         test host for the Search.CollatorDSO OLE DB provider. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.McpServer.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
    <ProjectReference Include="..\OutlookAI.McpServer\OutlookAI.McpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Absolute path to the built server exe, baked in at build time so the T3
         conformance test can spawn it regardless of the test host's working directory.
         The ProjectReference above guarantees the exe is built first. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>McpServerExePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\OutlookAI.McpServer\bin\$(Configuration)\net10.0-windows\OutlookAI.McpServer.exe'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
