<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The killable COM child (see Docs/com-host.md). net10.0-windows x64 to match the
      parent: the two exes publish into the SAME directory and share every dependency
      DLL, so the child costs ~163 KB on top of the parent rather than a second copy of
      the ~6 MB dependency set. That matters - the installer sits under a 50 MB updater
      cap that the embedded Office runtime already consumes most of.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.ComHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OutlookAI.ComHost</AssemblyName>
    <!--
      Deliberately NOT set: RuntimeIdentifier. Adding one moves build output to
      bin\$(Configuration)\net10.0-windows\win-x64\ and breaks the T3 harness, which
      resolves the server exe through a RID-less path baked into the test assembly.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
  </ItemGroup>

</Project>
