<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One-shot operator console for the 2026-07-25 incident remediation
         (v3.MD section 0.8, SOAK FIX LOG entry 7 closure). net10.0-windows x64 like
         the server host; COM against the same profile. NOT part of the product
         surface - the shipped MCP server keeps zero delete tools (S1 v2). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.RemediationTools</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core supplies the proven COM failure classification
         (OutlookComSession.IsComCallFailure - late-bound COM maps HRESULTs to plain
         .NET exceptions, v3.MD Phase-2 fact 2). -->
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
  </ItemGroup>

</Project>
