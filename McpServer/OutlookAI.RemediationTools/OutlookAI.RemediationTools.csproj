<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Operator console for the synthetic measurement corpus and the test guests' fixture
         populations (Program.cs). net11.0-windows x64 like the server host; COM against
         the guest's profile. NOT part of the product surface - the shipped MCP server keeps
         zero delete tools (S1 v2). Its incident commands went on 2026-11-18 (Q170 (a)). -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OutlookAI.RemediationTools</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core supplies the proven COM failure classification
         (OutlookComSession.IsComCallFailure - late-bound COM maps HRESULTs to plain
         .NET exceptions, v3.MD Phase-2 fact 2). -->
    <ProjectReference Include="..\OutlookAI.Core\OutlookAI.Core.csproj" />
  </ItemGroup>

</Project>
