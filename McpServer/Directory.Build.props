<Project>
  <!--
    Shared build settings for all v3 McpServer projects (see v3.MD sections 0.4/0.5).
    Scoped to McpServer/ only - the VSTO add-in at the repo root is old-style MSBuild
    and is not affected by this file. OutlookAI.Core keeps these settings when the add-in's
    build builds it, through the add-in's reference to it (Q167 (a)).

    Build these projects by explicit csproj path (dotnet build McpServer/...), never
    via OutlookAI.slnx: the solution holds the VSTO project, which cannot be built with
    `dotnet build`, and OutlookAI.Core, which the add-in references.
  -->
  <PropertyGroup>
    <!--
      Developer-build version, matching the add-in's Properties/AssemblyInfo.cs convention
      (v3.MD Phase 8 / R11): both components carry 99.99.99.0 until a release stamps them.
      The release build (Tools/Publish-Release.ps1) overrides this with -p:Version=<version>,
      the same value it stamps into AssemblyInfo.cs, so one release produces one version across
      the whole app.
      Major 99 is the marker the add-in's UpdateService uses to skip self-updating a dev build.
    -->
    <Version>99.99.99.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      The .NET SDK's security analysers (Q125, decided by the maintainer 2026-10-03): every rule in
      the Security category that .NET 11 ships, and under TreatWarningsAsErrors every finding is a
      build error. The level and the reasons for it are written once, in the add-in's
      NetSecurityAnalyzers.targets at the repository root, which runs the same rules at the same
      level in the old-style add-in project; keep the two numbers equal. EnableNETAnalyzers because a
      net48 target (OutlookAI.Core, OutlookAI.AuditLogStress) does not run the analysers otherwise.
      A false positive is suppressed at its site with a written Justification, never here.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevelSecurity>11.0-all</AnalysisLevelSecurity>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OutlookAI.McpServer'">
    <!--
      THE RUNTIME THE INSTALLED SERVER STARTS ON (Q172, decided by the maintainer 2026-11-18). The SDK
      writes these into the PUBLISHED apphost only - a build's own keeps the default search, so a
      developer build and the test suite run on their SDK's machine-wide runtime as before. The
      published one looks in two places, in this order: ..\..\dotnet from its own folder - setup
      puts it in %LOCALAPPDATA%\OutlookAI\Setup\McpServer, so that is %LOCALAPPDATA%\OutlookAI\dotnet,
      the private copy of Microsoft's runtime setup downloads there - and then the machine-wide .NET.
      Not DOTNET_ROOT: a variable pointing at another .NET would shadow both. OutlookAI.Core.AddIn's
      ServerDotnetRuntime names the folder and the version, and Tools/Checks/check-pinned-constants.ps1
      holds the three together. Measured 2026-11-18 with SDK 11.0.100 on a scratch app: with the
      private copy there, the apphost ran on it although a machine-wide .NET 11 was installed; with
      it gone, on the machine-wide one; and with AppRelative alone and no copy, it refused to start.
      NOT THE COM HOST'S: the server's publish leaves out a referenced executable whose apphost has
      these options (measured the same day - its publish apphost is made only when it is published
      itself), so the COM host keeps the default search and the server starts it with DOTNET_ROOT
      naming the server's own runtime (ComHostSupervisor.OwnRuntimeVariables): one runtime for both.
    -->
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>..\..\dotnet</AppHostRelativeDotNet>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Every [DllImport] in these assemblies loads its DLL from System32 and nowhere else (CA5392,
      Q125). Each one names a Windows DLL - kernel32, user32, ole32, and in the tests dwmapi and
      propsys - and without this the search starts in the program's own folder, which for an
      installed server is the user-writable install folder under %LOCALAPPDATA%. Properties\
      AssemblyInfo.cs does the same for the add-in.
    -->
    <AssemblyAttribute Include="System.Runtime.InteropServices.DefaultDllImportSearchPathsAttribute">
      <_Parameter1>System.Runtime.InteropServices.DllImportSearchPath.System32</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
